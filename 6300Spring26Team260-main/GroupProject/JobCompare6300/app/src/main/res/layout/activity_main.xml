<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Job Offer Comparison"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="48dp"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnCurrentJob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Enter/Edit Current Job Details"
            android:layout_marginBottom="16dp"
            android:padding="16dp"/>

        <Button
            android:id="@+id/btnEnterOffers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Enter Job Offers"
            android:layout_marginBottom="16dp"
            android:padding="16dp"/>

        <Button
            android:id="@+id/btnAdjustSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Adjust Comparison Settings"
            android:layout_marginBottom="16dp"
            android:padding="16dp"/>

        <Button
            android:id="@+id/btnCompareJobs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Compare Job Offers"
            android:padding="16dp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>