<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Job Details"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_margin="24dp" />

        <!-- Title 1-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Title 1:"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/jobTitle1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter job title"
                android:inputType="text"
                android:padding="8dp"/>
        </LinearLayout>
        <!-- Title 2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:background="@color/design_default_color_secondary">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Title 2:"
                android:textSize="18sp"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/jobTitle2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter job title"
                android:inputType="text"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Company 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Company 1:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/jobCompany1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter company name"
                android:inputType="text"
                android:padding="8dp"/>
        </LinearLayout>
        <!-- Company 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:background="@color/design_default_color_secondary">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Company 2:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/jobCompany2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter company name"
                android:inputType="text"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Location 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Location 1:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/jobLocation1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="City, State"
                android:inputType="text"
                android:padding="8dp"/>
        </LinearLayout>
        <!-- Location 2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:background="@color/design_default_color_secondary">
            >

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Location 2:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/jobLocation2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="City, State"
                android:inputType="text"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Yearly Salary 1-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="130dp"
                android:layout_height="65dp"
                android:text="Yearly Salary (Adjusted For Cost of Living) 1:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/yearlySalary1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:padding="8dp" />
        </LinearLayout>
        <!-- Yearly Salary 2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:background="@color/design_default_color_secondary">
            >

            <TextView
                android:layout_width="130dp"
                android:layout_height="65dp"
                android:text="Yearly Salary (Adjusted For Cost of Living) 2:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/yearlySalary2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Yearly Bonus 1-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="130dp"
                android:layout_height="65dp"
                android:text="Yearly Bonus (Adjusted For Cost of Living) 1:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/yearlyBonus1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>
        <!-- Yearly Bonus 2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:background="@color/design_default_color_secondary">
            >

            <TextView
                android:layout_width="130dp"
                android:layout_height="65dp"
                android:text="Yearly Bonus (Adjusted For Cost of Living) 2:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/yearlyBonus2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Stock Option Shares 1-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock Options 1:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stockOptions1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Assumes 3-year vesting"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>
        <!-- Stock Option Shares 2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:background="@color/design_default_color_secondary">
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock Options 2:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stockOptions2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Assumes 3-year vesting"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Wellness Stipend 1-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wellness Stipend 1:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wellnessStipend1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0-1200 inclusive annually"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>
        <!-- Wellness Stipend 2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:background="@color/design_default_color_secondary">
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wellness Stipend 2:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wellnessStipend2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0-1200 inclusive annually"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Life Insurance 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="144dp"
                android:layout_height="wrap_content"
                android:text="Life Insurance 1:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lifeInsurance1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="% of Yearly Salary 0-10%"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>
        <!-- Life Insurance 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:background="@color/design_default_color_secondary">
            >

            <TextView
                android:layout_width="144dp"
                android:layout_height="wrap_content"
                android:text="Life Insurance 2:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lifeInsurance2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="% of Yearly Salary 0-10%"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Personal Development Fund 1-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Dev Fund 1:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/personalDevFund1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0 to 6000 inclusive annually"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>
        <!-- Personal Development Fund 2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp"
            android:background="@color/design_default_color_secondary">
            >

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Dev Fund 2:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/personalDevFund2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0 to 6000 inclusive annually"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>
        <!-- Job Score 1-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Job Score 1:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/jobScore1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Job Score 1"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>
        <!-- Job Score 2-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp"
            android:background="@color/design_default_color_secondary">
            >

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Job Score 2:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/jobScore2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Job Score 2"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="36dp">

            <Button
                android:id="@+id/btnMainMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Main Menu"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnAnotherComparison"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Another Comparison"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>